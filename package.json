{
  "name": "ledgerdesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev",
    "dev:local": "npm run db:up && prisma generate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:status": "docker compose ps && (nc -z localhost 5434 && echo 'Postgres port 5434: open' || echo 'Postgres port 5434: closed — run npm run db:up after Docker Desktop is running')",
    "test:pdf": "tsx scripts/test-pdf-ai.ts",
    "test:pdf:ai": "tsx scripts/test-pdf-ai.ts --ai",
    "test:calcs": "tsx scripts/test-calc-modules.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.49.0",
    "nanoid": "^6.0.1",
    "next": "16.3.8",
    "nuqs": "^2.10.1",
    "openai": "^7.32.0",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
