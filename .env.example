# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://ledgerdesk:ledgerdesk@localhost:5434/ledgerdesk?schema=public

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Bootstrap super admin (created on seed)
SUPER_ADMIN_EMAIL=admin@ledgerdesk.local
SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin_123!
SUPER_ADMIN_NAME=LedgerDesk Super Admin

# Webhooks (HMAC shared secret for inbound providers)
WEBHOOK_SECRET=replace-with-webhook-hmac-secret

# OpenAI — PDF statement AI extract (server-only; used when local PDF parse finds few/no rows)
OPENAI_API_KEY=
OPENAI_PDF_MODEL=gpt-4o-mini

# Optional future bank-feed bridge
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
